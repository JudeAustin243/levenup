// Helper function to shuffle options and update correctAnswers indices
function shuffleOptions(options: string[], correctAnswers: number[]) {
  // Create array of indices
  const indices = options.map((_, i) => i);

  // Fisher-Yates shuffle
  for (let i = indices.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [indices[i], indices[j]] = [indices[j], indices[i]];
  }

  // Create shuffled options array
  const shuffledOptions = indices.map((i) => options[i]);

  // Update correctAnswers indices to match new positions
  const shuffledCorrectAnswers = correctAnswers.map((oldIdx) =>
    indices.indexOf(oldIdx)
  );

  return { options: shuffledOptions, correctAnswers: shuffledCorrectAnswers };
}


      questionText: "Three of the words in each list are linked. Mark the two words that are not related to these three.",
      options: ["red", "blue", "green", "loud", "bright"],
      correctAnswer: 0,
      correctAnswers: [3, 4], // loud and bright are not colours
      explanation: "Red, blue, and green are all colours. Loud and bright are adjectives that describe sound and light intensity, so they are the odd ones out.",
      difficulty: 5,
      tags: ["verbal_reasoning", "categories"],
      ageRange: "10-11",
      examBoard: "GL",
    },

    // NOTE: In a complete implementation, I would add 10 questions for each of the remaining types (7-16)
    // For now, I've added representative samples. Let me add a few more to reach a substantial count.
    // I'll add more complete questions for the remaining types to get closer to 160 total.

  ];

  // Insert all questions into database
  for (const q of questions) {
    // Shuffle options for multi-select questions to randomize answer positions
    // EXCEPT for opposite_meaning, compound_words, and sentence_completion_analogies questions where column position matters
    let options = q.options;
    let correctAnswers = q.correctAnswers;

    const columnBasedQuestions = ["opposite_meaning", "similar_meaning", "compound_words", "sentence_completion_analogies"];
    if (correctAnswers && Array.isArray(correctAnswers) && correctAnswers.length > 0 && !columnBasedQuestions.includes(q.questionType)) {
      const shuffled = shuffleOptions(options as string[], correctAnswers);
      options = shuffled.options;
      correctAnswers = shuffled.correctAnswers;
    }

    await prisma.question.create({
      data: {
        topicId: q.topicId,
        questionText: q.questionText,
        options: options,
        correctAnswer: q.correctAnswer,
        correctAnswers: correctAnswers || undefined, // Only set if present
        explanation: q.explanation,
        difficulty: 5q.difficulty,
        tags: q.tags,
        type: "mcq",
        ageRange: q.ageRange,
        examBoard: q.examBoard,
        questionType: q.questionType,
      },
    });
  }

  console.log(`✅ Seeded ${questions.length} GL Verbal Reasoning questions`);
}
